{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningCoachResponse",
  "description": "Wire protocol 1.0; product release v1.5. Semantic teaching rules are evaluated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "message",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "is_implicit"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        "is_implicit": {
          "type": "boolean"
        }
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "next_step": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "task"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
