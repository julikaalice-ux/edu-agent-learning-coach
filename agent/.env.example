FOUNDRY_PROJECT_ENDPOINT="..."
AZURE_AI_MODEL_DEPLOYMENT_NAME="..."
# Optional per-agent deployment; roles left unset use AZURE_AI_MODEL_DEPLOYMENT_NAME.
# Roles: COORDINATOR, VERIFIER, NOTES, VISUALIZER, QUIZZER.
LEARNING_COACH_MODEL_VISUALIZER="gpt-6-luna"
LEARNING_COACH_MODEL_VERIFIER="gpt-6-luna"
# Comparison only: "single" runs the single-agent baseline instead of the multi-agent coach.
# LEARNING_COACH_ARCHITECTURE=multi
# LEARNING_COACH_MODEL_SINGLE=      # the baseline's deployment; defaults to AZURE_AI_MODEL_DEPLOYMENT_NAME

# Local memory and generated teaching artifacts; keep out of source control.
LEARNING_COACH_DATA_DIR=".learning-coach"
LEARNING_COACH_PUBLIC_BASE_URL="http://localhost:8088"
# Optional native schema mode; local validation is always active.
LEARNING_COACH_NATIVE_JSON="0"
# Optional; without this key, research uses Wikipedia.
# TAVILY_API_KEY="..."
# First-meeting questions (stage + record consent). Set 0 for automated evals.
LEARNING_COACH_ONBOARDING="1"
# Demonstrations only: skip those questions, preset the stage and turn records on.
LEARNING_COACH_DEMO_MODE="0"
LEARNING_COACH_DEMO_STAGE="高中"

# What each agent sees, in tokens (defaults shown; see learning_coach/domain/context.py).
# LEARNING_COACH_CTX_DECIDE_WINDOW=4000
# LEARNING_COACH_CTX_RESPOND_WINDOW=2000
# LEARNING_COACH_CTX_SUB_WINDOW=1000
# LEARNING_COACH_CTX_MEMORY=1500
# LEARNING_COACH_CTX_NOTES=1000
# LEARNING_COACH_CTX_NOTES_MESSAGES=3000
# Token counting: tiktoken (o200k_base; falls back to an estimate if unavailable) or estimate.
# LEARNING_COACH_TOKENIZER=tiktoken

# Illustrations: "flux" (Foundry, signed-in Azure identity) or "pollinations" (keyless fallback).
# LEARNING_COACH_IMAGE_BACKEND=flux
# LEARNING_COACH_FLUX_DEPLOYMENT=flux-2-pro
# LEARNING_COACH_FLUX_ACCOUNT_ENDPOINT=   # defaults to the account behind FOUNDRY_PROJECT_ENDPOINT

# Foundry Memory semantic layer; unset = pure SQLite. The store must exist
# (see scripts/setup-memory.sh) before enabling. Failures degrade to SQLite.
# LEARNING_COACH_MEMORY_STORE=edu-agent-learning-memory
# LEARNING_COACH_MEMORY_SEARCH_MAX=6
# LEARNING_COACH_MEMORY_TIMEOUT=5
# Public blob container for hosted interactive visuals (created by
# scripts/setup-artifact-blob.sh). Unset = links use the local /artifacts
# route (Space demo default).
# LEARNING_COACH_ARTIFACT_BLOB_URL="https://<account>.blob.core.windows.net/artifacts"

# Demo page only (space/app.py).
# PORT=8000
# DEMO_ACCESS_KEY=                 # when set, only links with ?key=<value> can chat
# DEMO_MAX_TURNS_PER_DAY=150       # 0 = no cap
# DEMO_MAX_IMAGES_PER_DAY=20       # 0 = no cap
# LEARNING_COACH_BROWSER_SECRET=   # encrypts the bare "visited before" flag; generated in the data folder if empty

# Hosted agent only (api/host.py): context isolation guard.
# LEARNING_COACH_CONTEXT_TTL_SECONDS=900  # seconds after which a reopened conversation starts fresh; 0 disables the time reset
